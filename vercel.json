{
  "rewrites": [
    { "source": "/((?!version\\.json|ritm\\.apk|vendor/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/ritm.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"ritm.apk\"" }
      ]
    }
  ]
}
